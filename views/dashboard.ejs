<%- include('partials/header') %>

<section class="stats-grid">
  <article class="stat-card">
    <p>Active Employees</p>
    <h3><%= stats.activeEmployees %></h3>
  </article>
  <article class="stat-card">
    <p>Present Today</p>
    <h3><%= stats.present %></h3>
  </article>
  <article class="stat-card">
    <p>Absent Today</p>
    <h3><%= stats.absent %></h3>
  </article>
  <article class="stat-card">
    <p>On Leave</p>
    <h3><%= stats.leaveCount %></h3>
  </article>
  <article class="stat-card">
    <p>Pending Leave Reviews</p>
    <h3><%= stats.pendingLeaves %></h3>
  </article>
</section>

<section class="panel">
  <div class="panel-head">
    <h3>Biometric System Metrics</h3>
  </div>
  <div class="metrics-grid">
    <article class="metric-card">
      <p>Face Enrolled Employees</p>
      <h4><%= metrics.totalFaceEnrolledEmployees %></h4>
    </article>
    <article class="metric-card">
      <p>Pending Face Enrollment</p>
      <h4><%= metrics.pendingFaceEnrollment %></h4>
    </article>
    <article class="metric-card">
      <p>Attendance Success Rate</p>
      <h4><%= (metrics.attendanceSuccessRate * 100).toFixed(1) %>%</h4>
    </article>
    <article class="metric-card">
      <p>Failed Verification Rate</p>
      <h4><%= (metrics.failedVerificationRate * 100).toFixed(1) %>%</h4>
    </article>
    <article class="metric-card <%= metrics.systemHealth === 'Healthy' ? 'good' : metrics.systemHealth === 'Attention' ? 'warn' : 'bad' %>">
      <p>System Health</p>
      <h4><%= metrics.systemHealth %></h4>
    </article>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <h3>Recent Team Records</h3>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Name</th>
          <th>Position</th>
          <th>Role</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!employees.length) { %>
          <tr>
            <td colspan="5">No employees added yet.</td>
          </tr>
        <% } %>
        <% employees.forEach((employee) => { %>
          <tr>
            <td><%= employee.employee_code %></td>
            <td><%= employee.full_name %></td>
            <td><%= employee.position || '-' %></td>
            <td><span class="role-chip"><%= employee.role %></span></td>
            <td>
              <span class="status-pill <%= employee.status === 'active' ? 'good' : 'bad' %>">
                <%= employee.status %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
