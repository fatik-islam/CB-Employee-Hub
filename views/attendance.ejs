<%- include('partials/header') %>

<section class="panel">
  <div class="panel-head">
    <h3>Daily Attendance</h3>
  </div>

  <form action="/attendance" method="get" class="inline-form">
    <label>
      Date
      <div class="date-field" data-date-field>
        <input
          class="date-input date-display-input"
          type="text"
          name="date"
          value="<%= formatDate(date) %>"
          placeholder="dd-mm-yyyy"
          inputmode="numeric"
          pattern="\d{2}-{1,2}\d{2}-{1,2}\d{4}"
          data-date-display
          required
        />
        <input class="date-native-input" type="date" tabindex="-1" aria-hidden="true" data-date-native />
        <button class="btn ghost date-open-btn" type="button" data-date-open aria-label="Open calendar" title="Open calendar">
          <svg class="date-open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5h1.5A2.75 2.75 0 0 1 22 7.75v11.5A2.75 2.75 0 0 1 19.25 22H4.75A2.75 2.75 0 0 1 2 19.25V7.75A2.75 2.75 0 0 1 4.75 5h1.5V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v9.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V10h-17Zm1.25-3.5c-.69 0-1.25.56-1.25 1.25V8.5h17v-.75c0-.69-.56-1.25-1.25-1.25H4.75Z"
            />
          </svg>
        </button>
      </div>
    </label>
    <button class="btn ghost" type="submit">Load</button>
  </form>

  <div class="table-wrap attendance-records-table">
    <table class="attendance-records-grid">
      <thead>
        <tr>
          <th>Code</th>
          <th>Name</th>
          <th>Position</th>
          <th>Status</th>
          <th>Source</th>
          <th>Updated</th>
          <th>Notes</th>
          <% if (canManage) { %><th>Manage</th><% } %>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr>
            <td colspan="<%= canManage ? 8 : 7 %>">No records found for this day.</td>
          </tr>
        <% } %>

        <% rows.forEach((row) => { %>
          <tr>
            <td><%= row.employee_code %></td>
            <td><%= row.full_name %></td>
            <td><%= row.position || '-' %></td>
            <td>
              <% const status = row.attendance_status || 'unmarked'; %>
              <span class="status-pill <%= status === 'present' ? 'good' : status === 'leave' ? 'warn' : status === 'absent' ? 'bad' : '' %>">
                <%= status %>
              </span>
            </td>
            <td><%= row.mark_source || '-' %></td>
            <td><%= row.updated_at ? formatDateTime(row.updated_at) : '-' %></td>
            <td><%= row.notes || '-' %></td>

            <% if (canManage) { %>
              <td>
                <form action="/attendance/mark" method="post" class="inline-manage">
                  <input type="hidden" name="employeeId" value="<%= row.employee_id %>" />
                  <input type="hidden" name="date" value="<%= date %>" />
                  <select name="status">
                    <option value="present" <%= row.attendance_status === 'present' ? 'selected' : '' %>>Present</option>
                    <option value="absent" <%= row.attendance_status === 'absent' ? 'selected' : '' %>>Absent</option>
                    <option value="leave" <%= row.attendance_status === 'leave' ? 'selected' : '' %>>Leave</option>
                  </select>
                  <input name="notes" maxlength="250" placeholder="Optional notes" value="<%= row.notes || '' %>" />
                  <button class="btn primary" type="submit">Save</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
