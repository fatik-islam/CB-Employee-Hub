<%- include('partials/header') %>

<section class="panel">
  <div class="panel-head">
    <h3>Add Employee</h3>
  </div>

  <form action="/employees" method="post" class="grid-form">
    <label>
      Employee Code
      <input name="employeeCode" required maxlength="32" placeholder="CB-001" />
    </label>

    <label>
      Full Name
      <input name="fullName" required maxlength="120" placeholder="Employee full name" />
    </label>

    <label>
      Phone
      <input name="phone" maxlength="30" placeholder="+8801..." />
    </label>

    <label>
      Position
      <input name="position" maxlength="80" placeholder="Counter Lead" />
    </label>

    <label>
      CNIC
      <input
        name="cnic"
        required
        maxlength="15"
        placeholder="45102-8391742-7"
        inputmode="numeric"
        pattern="\d{5}-\d{7}-\d"
      />
    </label>

    <label class="full-width">
      Address
      <textarea name="address" rows="2" maxlength="300" placeholder="Employee address" required></textarea>
    </label>

    <label>
      Joining Date
      <div class="date-field" data-date-field>
        <input
          class="date-input date-display-input"
          type="text"
          name="joiningDate"
          placeholder="dd-mm-yyyy"
          inputmode="numeric"
          pattern="\d{2}-{1,2}\d{2}-{1,2}\d{4}"
          data-date-display
          required
        />
        <input class="date-native-input" type="date" tabindex="-1" aria-hidden="true" data-date-native />
        <button class="btn ghost date-open-btn" type="button" data-date-open aria-label="Open calendar" title="Open calendar">
          <svg class="date-open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5h1.5A2.75 2.75 0 0 1 22 7.75v11.5A2.75 2.75 0 0 1 19.25 22H4.75A2.75 2.75 0 0 1 2 19.25V7.75A2.75 2.75 0 0 1 4.75 5h1.5V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v9.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V10h-17Zm1.25-3.5c-.69 0-1.25.56-1.25 1.25V8.5h17v-.75c0-.69-.56-1.25-1.25-1.25H4.75Z"
            />
          </svg>
        </button>
      </div>
    </label>

    <label>
      Salary Date
      <div class="date-field" data-date-field>
        <input
          class="date-input date-display-input"
          type="text"
          name="salaryDate"
          placeholder="dd-mm-yyyy"
          inputmode="numeric"
          pattern="\d{2}-{1,2}\d{2}-{1,2}\d{4}"
          data-date-display
          required
        />
        <input class="date-native-input" type="date" tabindex="-1" aria-hidden="true" data-date-native />
        <button class="btn ghost date-open-btn" type="button" data-date-open aria-label="Open calendar" title="Open calendar">
          <svg class="date-open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5h1.5A2.75 2.75 0 0 1 22 7.75v11.5A2.75 2.75 0 0 1 19.25 22H4.75A2.75 2.75 0 0 1 2 19.25V7.75A2.75 2.75 0 0 1 4.75 5h1.5V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v9.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V10h-17Zm1.25-3.5c-.69 0-1.25.56-1.25 1.25V8.5h17v-.75c0-.69-.56-1.25-1.25-1.25H4.75Z"
            />
          </svg>
        </button>
      </div>
    </label>

    <label>
      Employment Role
      <select name="role" required>
        <option value="staff">Staff</option>
        <option value="manager">Manager</option>
      </select>
    </label>

    <div class="full-width">
      <button class="btn primary" type="submit">Add Employee</button>
    </div>
  </form>
</section>

<% if (editingEmployee) { %>
  <section class="panel">
    <div class="panel-head">
      <h3>Update Employee: <%= editingEmployee.full_name %></h3>
    </div>

    <form action="/employees/<%= editingEmployee.id %>/update" method="post" class="grid-form">
      <label>
        Employee Code
        <input name="employeeCode" required maxlength="32" value="<%= editingEmployee.employee_code %>" />
      </label>

      <label>
        Full Name
        <input name="fullName" required maxlength="120" value="<%= editingEmployee.full_name %>" />
      </label>

      <label>
        Phone
        <input name="phone" maxlength="30" value="<%= editingEmployee.phone || '' %>" />
      </label>

      <label>
        Position
        <input name="position" maxlength="80" value="<%= editingEmployee.position || '' %>" />
      </label>

      <label>
        CNIC
        <input
          name="cnic"
          required
          maxlength="15"
          value="<%= editingEmployee.cnic || '' %>"
          placeholder="45102-8391742-7"
          inputmode="numeric"
          pattern="\d{5}-\d{7}-\d"
        />
      </label>

      <label class="full-width">
        Address
        <textarea name="address" rows="2" maxlength="300" placeholder="Employee address" required><%= editingEmployee.address || '' %></textarea>
      </label>

      <label>
        Joining Date
        <div class="date-field" data-date-field>
          <input
            class="date-input date-display-input"
            type="text"
            name="joiningDate"
            value="<%= editingEmployee.joining_date ? formatDate(editingEmployee.joining_date) : '' %>"
            placeholder="dd-mm-yyyy"
            inputmode="numeric"
            pattern="\d{2}-{1,2}\d{2}-{1,2}\d{4}"
            data-date-display
            required
          />
          <input class="date-native-input" type="date" tabindex="-1" aria-hidden="true" data-date-native />
          <button class="btn ghost date-open-btn" type="button" data-date-open aria-label="Open calendar" title="Open calendar">
            <svg class="date-open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5h1.5A2.75 2.75 0 0 1 22 7.75v11.5A2.75 2.75 0 0 1 19.25 22H4.75A2.75 2.75 0 0 1 2 19.25V7.75A2.75 2.75 0 0 1 4.75 5h1.5V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v9.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V10h-17Zm1.25-3.5c-.69 0-1.25.56-1.25 1.25V8.5h17v-.75c0-.69-.56-1.25-1.25-1.25H4.75Z"
              />
            </svg>
          </button>
        </div>
      </label>

      <label>
        Salary Date
        <div class="date-field" data-date-field>
          <input
            class="date-input date-display-input"
            type="text"
            name="salaryDate"
            value="<%= editingEmployee.salary_date ? formatDate(editingEmployee.salary_date) : '' %>"
            placeholder="dd-mm-yyyy"
            inputmode="numeric"
            pattern="\d{2}-{1,2}\d{2}-{1,2}\d{4}"
            data-date-display
            required
          />
          <input class="date-native-input" type="date" tabindex="-1" aria-hidden="true" data-date-native />
          <button class="btn ghost date-open-btn" type="button" data-date-open aria-label="Open calendar" title="Open calendar">
            <svg class="date-open-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5h1.5A2.75 2.75 0 0 1 22 7.75v11.5A2.75 2.75 0 0 1 19.25 22H4.75A2.75 2.75 0 0 1 2 19.25V7.75A2.75 2.75 0 0 1 4.75 5h1.5V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v9.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V10h-17Zm1.25-3.5c-.69 0-1.25.56-1.25 1.25V8.5h17v-.75c0-.69-.56-1.25-1.25-1.25H4.75Z"
              />
            </svg>
          </button>
        </div>
      </label>

      <label>
        Employment Role
        <select name="role" required>
          <option value="staff" <%= editingEmployee.role === 'staff' ? 'selected' : '' %>>Staff</option>
          <option value="manager" <%= editingEmployee.role === 'manager' ? 'selected' : '' %>>Manager</option>
        </select>
      </label>

      <label>
        Status
        <select name="status" required>
          <option value="active" <%= editingEmployee.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= editingEmployee.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </label>

      <div class="full-width split-actions">
        <button class="btn primary" type="submit">Save Changes</button>
        <a class="btn ghost" href="/employees">Cancel</a>
      </div>
    </form>
  </section>
<% } %>

<section class="panel">
  <div class="panel-head">
    <h3>Employee Directory</h3>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Code</th>
          <th>Name</th>
          <th>Position</th>
          <th>Role</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!employees.length) { %>
          <tr>
            <td colspan="6">No employees yet.</td>
          </tr>
        <% } %>

        <% employees.forEach((employee) => { %>
          <tr>
            <td><%= employee.employee_code %></td>
            <td>
              <button
                class="employee-name-trigger"
                type="button"
                data-employee-view
                data-employee-code="<%= employee.employee_code %>"
                data-employee-name="<%= employee.full_name %>"
                data-employee-phone="<%= employee.phone || '-' %>"
                data-employee-position="<%= employee.position || '-' %>"
                data-employee-role="<%= employee.role %>"
                data-employee-status="<%= employee.status %>"
                data-employee-cnic="<%= employee.cnic || '-' %>"
                data-employee-address="<%= (employee.address || '-').replace(/\s+/g, ' ').trim() %>"
                data-employee-joining-date="<%= employee.joining_date ? formatDate(employee.joining_date) : '-' %>"
                data-employee-salary-date="<%= employee.salary_date ? formatDate(employee.salary_date) : '-' %>"
              >
                <%= employee.full_name %>
              </button>
            </td>
            <td><%= employee.position || '-' %></td>
            <td><span class="role-chip"><%= employee.role %></span></td>
            <td>
              <span class="status-pill <%= employee.status === 'active' ? 'good' : 'bad' %>">
                <%= employee.status %>
              </span>
            </td>
            <td>
              <div class="split-actions">
                <a class="btn ghost" href="/employees?edit=<%= employee.id %>">Edit</a>
                <form
                  action="/employees/<%= employee.id %>/delete"
                  method="post"
                  data-confirm-form
                  data-confirm-title="Delete Employee"
                  data-confirm-message="Delete <%= employee.full_name %> (<%= employee.employee_code %>) and all linked records?"
                  data-confirm-proceed="Delete Employee"
                >
                  <button class="btn danger" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<div class="modal hidden employee-details-modal" id="employeeDetailsModal" role="dialog" aria-modal="true" aria-labelledby="employeeDetailsTitle">
  <div class="modal-card employee-details-card">
    <button class="employee-modal-close" id="employeeDetailsCloseBtn" type="button" aria-label="Close employee details">×</button>
    <h3 id="employeeDetailsTitle">Employee Information</h3>

    <div class="employee-details-grid">
      <div class="employee-detail-item">
        <span>Employee Code</span>
        <strong id="employeeDetailsCode">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Full Name</span>
        <strong id="employeeDetailsName">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Phone</span>
        <strong id="employeeDetailsPhone">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Position</span>
        <strong id="employeeDetailsPosition">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Employment Role</span>
        <strong id="employeeDetailsRole">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Status</span>
        <strong id="employeeDetailsStatus">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>CNIC</span>
        <strong id="employeeDetailsCnic">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Joining Date</span>
        <strong id="employeeDetailsJoiningDate">-</strong>
      </div>
      <div class="employee-detail-item">
        <span>Salary Date</span>
        <strong id="employeeDetailsSalaryDate">-</strong>
      </div>
      <div class="employee-detail-item employee-detail-item-full">
        <span>Address</span>
        <strong id="employeeDetailsAddress">-</strong>
      </div>
    </div>
  </div>
</div>

<script src="/public/js/employee-directory.js"></script>

<%- include('partials/footer') %>
